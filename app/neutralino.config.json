{
  "$schema": "https://raw.githubusercontent.com/neutralinojs/neutralinojs/main/schemas/neutralino.config.schema.json",
  "applicationId": "dev.unigit.app",
  "applicationName": "uni-git",
  "author": "roflseech",
  "description": "Easy Git client with Unity integrations",
  "version": "0.1.0",
  "defaultMode": "window",
  "port": 0,
  "documentRoot": "/resources/",
  "url": "/",
  "enableServer": true,
  "enableNativeAPI": true,
  "tokenSecurity": "one-time",
  "logging": {
    "enabled": false,
    "writeToLogFile": false
  },
  "nativeAllowList": [
    "app.*",
    "os.*",
    "filesystem.*",
    "window.*",
    "events.*",
    "extensions.*",
    "debug.*"
  ],
  "modes": {
    "window": {
      "title": "uni-git",
      "width": 1180,
      "height": 760,
      "minWidth": 800,
      "minHeight": 500,
      "center": true,
      "icon": "/resources/icons/appIcon.png",
      "enableInspector": false,
      "borderless": false,
      "maximize": false,
      "hidden": false,
      "resizable": true,
      "exitProcessOnClose": false
    }
  },
  "cli": {
    "binaryName": "uni-git",
    "resourcesPath": "/resources/",
    "extensionsPath": "/extensions/",
    "clientLibrary": "/client/neutralino.js",
    "binaryVersion": "6.9.0",
    "clientVersion": "6.9.0",
    "extensionsExclude": ".*.map$"
  },
  "enableExtensions": true,
  "extensions": [
    {
      "id": "dev.unigit.backend",
      "commandWindows": "node \"${NL_PATH}/extensions/backend/main.js\"",
      "commandDarwin": "/bin/sh \"${NL_PATH}/extensions/backend/run.sh\"",
      "commandLinux": "/bin/sh \"${NL_PATH}/extensions/backend/run.sh\""
    }
  ]
}
